# A dedicated Base RPC is recommended for continuous polling.
RPC_URL=https://mainnet.base.org

# Paper-monitor settings
TRADE_SIZE_USDC=100
MIN_NET_PROFIT_USDC=0.25
POLL_INTERVAL_MS=12000
GAS_OVERHEAD=100000
# Covers Base L1 data fees and unmodeled execution costs. Tune from real simulations.
EXECUTION_COST_BUFFER_USDC=0.02
SHOW_ALL=false
ONCE=false

# Optional Twilio SMS alerts. Set all four values to enable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=
ALERT_COOLDOWN_MINUTES=15

# Optional: replace the defaults with other Uniswap V3 Quoter V2-compatible routes.
# ROUTES_JSON=[{"name":"DEX A 0.05%","quoter":"0x...","fee":500},{"name":"DEX B 0.3%","quoter":"0x...","fee":3000}]